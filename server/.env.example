# Postgres — any hosted Postgres works (Neon, Supabase, Render, Railway, your own box).
# Local dev example: postgres://postgres:postgres@localhost:5432/planforge
DATABASE_URL=postgres://user:password@host:5432/planforge

JWT_SECRET=change-this-to-a-long-random-string

# CORS — comma-separated list of origins allowed to call this API.
# Include your hosted PWA's domain and, for the Android app, https://localhost
ALLOWED_ORIGINS=https://your-site.com,https://localhost

PORT=3000

# Used to encrypt each organization's Anthropic API key at rest. Generate with:
#   openssl rand -hex 32
# or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing/changing this makes existing stored keys undecryptable — treat it like a
# credential, back it up, never commit it.
ENCRYPTION_KEY=

# Note: there is no ANTHROPIC_API_KEY here. Each organization supplies its own when
# they redeem their license key, and it's stored (encrypted) per-org in the database.

# SMTP — any provider works: Gmail (with an app password), Amazon SES, Postmark,
# Mailgun, your own relay. Used for "forgot password" reset codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PlanForge <no-reply@your-domain.com>
# If SMTP_HOST is left blank, email reset is disabled and the app falls back to
# the offline recovery code from setup — nothing else breaks.
