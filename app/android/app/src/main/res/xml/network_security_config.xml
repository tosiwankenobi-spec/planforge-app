<?xml version="1.0" encoding="utf-8"?>
<!-- Allows plain HTTP only to the emulator's host-loopback alias, for local dev against
     `npm start` in /server. Remove/tighten before shipping a release build. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
